{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div
  class="password-footer color-custom-{{ section.id }}"
  data-testid="password-footer"
>
  <ul class="password-footer__social-list" role="list">
    {%- if section.settings.facebook_url != blank -%}
      <li>
        <a href="{{ section.settings.facebook_url }}" class="password-footer__social-link" aria-label="Facebook" target="_blank" rel="noopener">
          {{- 'icon-facebook.svg' | inline_asset_content -}}
        </a>
      </li>
    {%- endif -%}
    {%- if section.settings.instagram_url != blank -%}
      <li>
        <a href="{{ section.settings.instagram_url }}" class="password-footer__social-link" aria-label="Instagram" target="_blank" rel="noopener">
          {{- 'icon-instagram.svg' | inline_asset_content -}}
        </a>
      </li>
    {%- endif -%}
    {%- if section.settings.tiktok_url != blank -%}
      <li>
        <a href="{{ section.settings.tiktok_url }}" class="password-footer__social-link" aria-label="TikTok" target="_blank" rel="noopener">
          {{- 'icon-tiktok.svg' | inline_asset_content -}}
        </a>
      </li>
    {%- endif -%}
    {%- if section.settings.twitter_url != blank -%}
      <li>
        <a href="{{ section.settings.twitter_url }}" class="password-footer__social-link" aria-label="X (Twitter)" target="_blank" rel="noopener">
          {{- 'icon-twitter.svg' | inline_asset_content -}}
        </a>
      </li>
    {%- endif -%}
    {%- if section.settings.youtube_url != blank -%}
      <li>
        <a href="{{ section.settings.youtube_url }}" class="password-footer__social-link" aria-label="YouTube" target="_blank" rel="noopener">
          {{- 'icon-youtube.svg' | inline_asset_content -}}
        </a>
      </li>
    {%- endif -%}
  </ul>
</div>

{% stylesheet %}
  .password-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-sm);
    padding-block: var(--padding-xl);
  }

  .password-footer__social-list {
    display: flex;
    align-items: center;
    gap: var(--gap-lg, 24px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .password-footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-foreground);
    transition: opacity 0.2s ease;
  }

  .password-footer__social-link:hover {
    opacity: 0.7;
  }

  .password-footer__social-link svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.footer_password",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "Social media links"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "X (Twitter)"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube"
    }
  ]
}
{% endschema %}