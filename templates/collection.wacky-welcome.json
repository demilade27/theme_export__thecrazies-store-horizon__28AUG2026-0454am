  padding: 48px 24px 80px;\n    text-align: center;\n    background: #ffffff;\n  }\n\n  .tc-shop__heading {\n    font-family: 'Press Start 2P', cursive;\n    font-size: 28px;\n    color: #B50023;\n    letter-spacing: 1px;\n    margin: 0 0 12px;\n  }\n\n  .tc-shop__subtitle {\n    font-family: 'Architects Daughter', cursive;\n    font-size: 18px;\n    color: #1694CB;\n    margin: 0 0 48px;\n  }\n\n  .tc-shop__grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));\n    gap: 40px;\n    max-width: 1100px;\n    margin: 0 auto;\n    justify-content: center;\n  }\n\n  .tc-shop__grid--single {\n    grid-template-columns: minmax(260px, 380px);\n  }\n\n  .tc-product {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    text-decoration: none;\n  }\n\n  .tc-product__image-wrap {\n    position: relative;\n    width: 100%;\n    aspect-ratio: 4 \/ 3;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    overflow: visible;\n    margin-bottom: 16px;\n  }\n\n  .tc-product__image-wrap img {\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),\n                filter 0.5s cubic-bezier(0.16, 1, 0.3, 1);\n  }\n\n  .tc-product:hover .tc-product__image-wrap img {\n    transform: scale(1.08);\n    filter: drop-shadow(0 14px 16px rgba(0, 0, 0, 0.16));\n  }\n\n  .tc-product__badge {\n    position: absolute;\n    top: 8px;\n    left: 8px;\n    background: #B50023;\n    color: #ffffff;\n    font-family: 'Luckiest Guy', cursive;\n    font-size: 13px;\n    letter-spacing: 0.5px;\n    padding: 6px 14px;\n    border-radius: 999px;\n    z-index: 2;\n  }\n\n  .tc-product__title {\n    font-family: 'Luckiest Guy', cursive;\n    font-size: 22px;\n    color: #B50023;\n    letter-spacing: 0.5px;\n    margin: 0 0 4px;\n  }\n\n  .tc-product__price {\n    font-family: 'Architects Daughter', cursive;\n    font-size: 17px;\n    color: #1a1a1a;\n    margin: 0;\n  }\n\n  .tc-shop__empty {\n    font-family: 'Architects Daughter', cursive;\n    font-size: 18px;\n    color: #666;\n    padding: 40px 0;\n  }\n\n  @media (max-width: 640px) {\n    .tc-shop {\n      padding: 36px 16px 56px;\n    }\n    .tc-shop__heading {\n      font-size: 20px;\n    }\n    .tc-shop__subtitle {\n      font-size: 15px;\n      margin-bottom: 32px;\n    }\n    .tc-shop__grid {\n      gap: 32px;\n    }\n  }\n<\/style>\n\n<section class=\"tc-shop\">\n  <h1 class=\"tc-shop__heading\">{{ collection.title | upcase }}<\/h1>\n  {% if collection.description != blank %}\n    <p class=\"tc-shop__subtitle\">{{ collection.description }}<\/p>\n  {% endif %}\n\n  {% if collection.products.size == 0 %}\n    <p class=\"tc-shop__empty\">No products in this collection yet — check back soon.<\/p>\n  {% else %}\n    <div class=\"tc-shop__grid{% if collection.products.size == 1 %} tc-shop__grid--single{% endif %}\">\n      {% for product in collection.products %}\n        <a href=\"{{ product.url }}\" class=\"tc-product\">\n          <div class=\"tc-product__image-wrap\">\n            {% if product.tags contains 'pre-order' %}\n              <span class=\"tc-product__badge\">PRE-ORDER<\/span>\n            {% endif %}\n            {% if product.featured_image %}\n              <img src=\"{{ product.featured_image | image_url: width: 600 }}\" alt=\"{{ product.title | escape }}\" loading=\"lazy\">\n            {% endif %}\n          <\/div>\n          <h3 class=\"tc-product__title\">{{ product.title }}<\/h3>\n          <p class=\"tc-product__price\">{{ product.price | money }}<\/p>\n        <\/a>\n      {% endfor %}\n    <\/div>\n  {% endif %}\n<\/section>","background_color":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"main":{"type":"main-collection","blocks":{"filters":{"type":"filters","static":true,"settings":{"enable_filtering":true,"filter_style":"horizontal","filter_width":"centered","text_label_case":"default","show_