text-align: center;\n    background: #ffffff;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .tc-shop__grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 24px;\n    max-width: 1140px;\n    margin: 0 auto;\n    align-items: stretch;\n  }\n\n  .tc-shop__left {\n    grid-row: span 2;\n    display: flex;\n  }\n\n  .tc-shop__right {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .tc-shop-card {\n    position: relative;\n    border-radius: 28px;\n    overflow: hidden;\n    text-decoration: none;\n    display: block;\n    width: 100%;\n    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);\n    transition: box-shadow 0.5s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);\n    opacity: 0;\n    transform: translateY(24px);\n  }\n\n  .tc-shop-card.tc-in-view {\n    opacity: 1;\n    transform: translateY(0);\n    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),\n                transform 0.8s cubic-bezier(0.16, 1, 0.3, 1),\n                box-shadow 0.5s ease;\n  }\n\n  .tc-shop-card:hover {\n    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.16);\n  }\n\n  \/* Left photo stretches to exactly match the two stacked right photos + gap *\/\n  .tc-shop__left .tc-shop-card {\n    flex: 1;\n  }\n\n  .tc-shop__right .tc-shop-card {\n    aspect-ratio: 3 \/ 2.15;\n  }\n\n  .tc-shop-card img {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: center center;\n    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);\n  }\n\n  .tc-shop-card__img--wacky {\n    object-position: center 15%;\n  }\n\n  .tc-shop-card:hover img {\n    transform: scale(1.06);\n  }\n\n  .tc-shop-card__scrim {\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    height: 55%;\n    background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.05) 40%, rgba(0,0,0,0.45) 100%);\n    pointer-events: none;\n  }\n\n  .tc-shop-card__content {\n    position: absolute;\n    left: 28px;\n    right: 28px;\n    bottom: 24px;\n    text-align: left;\n    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);\n  }\n\n  .tc-shop-card:hover .tc-shop-card__content {\n    transform: translateY(-6px);\n  }\n\n  .tc-shop-card__title {\n    font-family: 'Luckiest Guy', cursive;\n    font-size: 27px;\n    color: #B50023;\n    letter-spacing: 0.5px;\n    margin: 0 0 4px;\n    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);\n  }\n\n  .tc-shop-card__subtitle {\n    font-family: 'Architects Daughter', cursive;\n    font-size: 16px;\n    color: #FFFFFF;\n    margin: 0;\n    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.12);\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .tc-shop-card,\n    .tc-shop-card img,\n    .tc-shop-card__content {\n      transition: none;\n      opacity: 1;\n      transform: none;\n    }\n  }\n\n  @media (max-width: 900px) {\n    .tc-shop-card__title {\n      font-size: 22px;\n    }\n  }\n\n  \/* Mobile: stack all 3 in one column *\/\n  @media (max-width: 640px) {\n    .tc-shop {\n      padding: 44px 16px 64px;\n    }\n    .tc-shop__grid {\n      grid-template-columns: 1fr;\n      gap: 18px;\n    }\n    .tc-shop__left {\n      grid-row: auto;\n    }\n    .tc-shop__left .tc-shop-card {\n      aspect-ratio: 3 \/ 3.2;\n      flex: none;\n    }\n    .tc-shop-card {\n      border-radius: 20px;\n    }\n    .tc-shop-card__content {\n      left: 20px;\n      right: 20px;\n      bottom: 18px;\n    }\n    .tc-shop-card__title {\n      font-size: 19px;\n    }\n    .tc-shop-card__subtitle {\n      font-size: 14px;\n    }\n  }\n<\/style>\n\n<section class=\"tc-shop\">\n\n  <div class=\"tc-shop__grid\">\n\n    <div class=\"tc-shop__left\">\n      <div class=\"tc-shop-card tc-reveal\">\n        <img src=\"{{ '4DB4188E-0125-498A-92EC-A6BE2510CBA5.jpg' | file_url }}\" alt=\"The Crazies lookbook photo\" loading=\"lazy\">\n      <\/div>\n    <\/div>\n\n    <div class=\"tc-shop__right\">\n      <a href=\"\/collections\/odd-collectible\" class=\"tc-shop-card tc-reveal\">\n        <img src=\"{{ 'cz7_1d24d84b-20eb-4d4b-be3e-586c9a88fb19.jpg' | file_url }}\" alt=\"Odd Collectible - Tar Black and Kuli Brown\">\n        <div class=\"tc-shop-card__scrim\"><\/div>\n        <div class=\"tc-shop-card__content\">\n          <h3 class=\"tc-shop-card__title\">ODD COLLECTIBLE<\/h3>\n          <p class=\"tc-shop-card__subtitle\">'TAR' BLACK &amp; 'KULI' BROWN<\/p>\n        <\/div>\n      <\/a>\n    <\/div>\n\n    <div class=\"tc-shop__right\">\n      <a href=\"\/collections\/wacky-welcome\" class=\"tc-shop-card tc-reveal\">\n        <img class=\"tc-shop-card__img--wacky\" src=\"{{ 'F4950CF1-EF5B-4439-9CD0-91E82256344B.jpg' | file_url }}\" alt=\"Wacky Welcome - Nature's Madness and Bloo\">\n        <div class=\"tc-shop-card__scrim\"><\/div>\n        <div class=\"tc-shop-card__content\">\n          <h3 class=\"tc-shop-card__title\">WACKY WELCOME<\/h3>\n          <p class=\"tc-shop-card__subtitle\">'NATURE'S MADNESS' &amp; 'BLOO'<\/p>\n        <\/div>\n      <\/a>\n    <\/div>\n\n  <\/div>\n<\/section>\n\n<script>\n  (function () {\n    var els = document.querySelectorAll('.tc-reveal');\n    if (!('IntersectionObserver' in window)) {\n      els.forEach(function (el) { el.classList.add('tc-in-view'); });\n      return;\n    }\n    var observer = new IntersectionObserver(function (entries) {\n      entries.forEach(function (entry) {\n        if (entry.isIntersecting) {\n          entry.target.classList.add('tc-in-view');\n          observer.unobserve(entry.target);\n        }\n      });\n    }, { threshold: 0.15 });\n    els.forEach(function (el) { observer.observe(el); });\n  })();\n<\/script>","background_color":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"main":{"type":"main-collection","blocks":{"filters":{"type":"filters","static":true,"settings":{"enable_filtering":true,"filter_style":"horizontal","filter_width":"centered","text_label_case":"default","show_swatch_label":false,"show_filter_label":fal