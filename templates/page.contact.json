"custom_button_border":"{{ settings.color_palette.background }}","width":"fit-content","custom_width":100,"width_mobile":"fit-content","custom_width_mobile":100},"blocks":{}}},"block_order":[]}},"block_order":["contact_form_UwiCkQ"],"disabled":true,"name":"t:names.contact_form","settings":{"content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"center","vertical_alignment_flex_direction_column":"center","gap":32,"section_width":"page-width","section_height":"","section_height_custom":50,"background_media":"none","background_color":"","video_position":"cover","background_image_position":"cover","toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","border":"none","border_width":1,"border_opacity":100,"border_color":"","border_radius":0,"padding-block-start":32,"padding-block-end":84}},"custom_liquid_bdcBnk":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Architects+Daughter&display=swap\" rel=\"stylesheet\">\n\n\n<style>\n  :root {\n    --tc-space-1: 8px;\n    --tc-space-2: 16px;\n    --tc-space-3: 24px;\n    --tc-space-4: 32px;\n    --tc-space-5: 48px;\n    --tc-space-6: 64px;\n    --tc-space-7: 96px;\n  }\n\n  .tc-about {\n    padding: var(--tc-space-6) var(--tc-space-3) var(--tc-space-7);\n    text-align: center;\n    background: #ffffff;\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n  }\n\n  .tc-about__collage {\n    max-width: 880px;\n    margin: 0 auto var(--tc-space-6);\n    border-radius: 18px;\n    overflow: hidden;\n    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);\n    opacity: 0;\n    transform: translateY(24px);\n    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),\n                transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);\n  }\n\n  .tc-about__collage.tc-in-view {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  .tc-about__collage img {\n    width: 100%;\n    height: auto;\n    display: block;\n  }\n\n  .tc-about__body {\n    max-width: 680px;\n    margin: 0 auto;\n  }\n\n  .tc-about__body p {\n    font-family: 'Architects Daughter', cursive;\n    font-size: 19px;\n    line-height: 1.85;\n    color: #1a1a1a;\n    margin: 0 0 var(--tc-space-4);\n    opacity: 0;\n    transform: translateY(16px);\n    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),\n                transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);\n  }\n\n  .tc-about__body p:first-of-type {\n    font-size: 21px;\n  }\n\n  .tc-about__body p.tc-in-view {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  .tc-about__divider {\n    width: 64px;\n    height: 3px;\n    background: #B50023;\n    border: none;\n    margin: var(--tc-space-2) auto var(--tc-space-4);\n    border-radius: 2px;\n    opacity: 0;\n    transform: scaleX(0);\n    transition: opacity 0.5s ease 0.1s,\n                transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.1s;\n  }\n\n  .tc-about__divider.tc-in-view {\n    opacity: 1;\n    transform: scaleX(1);\n  }\n\n  .tc-about__closing {\n    font-family: 'Architects Daughter', cursive;\n    font-size: 20px;\n    color: #1a1a1a;\n    margin: 0;\n    padding-top: var(--tc-space-1);\n  }\n\n  .tc-about__closing span {\n    display: inline-block;\n    color: #B50023;\n    font-weight: 700;\n    text-transform: uppercase;\n    font-size: 22px;\n    letter-spacing: 0.5px;\n    position: relative;\n    margin-top: var(--tc-space-1);\n  }\n\n  .tc-about__closing span::after {\n    content: '';\n    position: absolute;\n    left: 0;\n    bottom: -6px;\n    width: 100%;\n    height: 2px;\n    background: #B50023;\n    transform: scaleX(0);\n    transform-origin: left;\n    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.3s;\n  }\n\n  .tc-about__closing.tc-in-view span::after {\n    transform: scaleX(1);\n  }\n\n  @media (max-width: 640px) {\n    .tc-about {\n      padding: var(--tc-space-4) var(--tc-space-2) var(--tc-space-5);\n    }\n    .tc-about__collage {\n      margin-bottom: var(--tc-space-4);\n      border-radius: 14px;\n    }\n    .tc-about__body p {\n      font-size: 16px;\n      line-height: 1.75;\n      margin-bottom: var(--tc-space-3);\n    }\n    .tc-about__body p:first-of-type {\n      font-size: 17px;\n    }\n    .tc-about__closing {\n      font-size: 17px;\n    }\n    .tc-about__closing span {\n      font-size: 18px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .tc-about__collage,\n    .tc-about__body p,\n    .tc-about__divider,\n    .tc-about__closing span::after {\n      transition: none;\n      opacity: 1;\n      transform: none;\n    }\n  }\n</style>\n\n<section class=\"tc-about\">\n\n  <div class=\"tc-about__collage tc-reveal\">\n    <img\n      src=\"{{ 'RESTOCK_POST.png' | file_url }}\"\n      alt=\"The Crazies group photo collage\"\n      loading=\"lazy\"\n    >\n  </div>\n\n  <div class=\"tc-about__body\">\n    <p class=\"tc-reveal\">At The Crazies, we get it. We were those kids too, the misunderstood creatives who weren't afraid to be different.</p>\n\n    <p class=\"tc-reveal\">Our brand name, The Crazies, aims to reclaim the negative connotation of \"crazy,\" turning it on its head to celebrate those who see the world a little differently. It's about embracing your unique passions, wild ideas, and anything but the ordinary self.</p>\n\n    <p class=\"tc-reveal\">The Crazies features unique characters: Jeff, Skipper, Retro, and Sounds, who embody this spirit. They're quirky, confident, a little offbeat, and proud of it. Through them, we remind you that being yourself isn't just okay, it's the greatest creation of all.</p>\n\n    <hr class=\"tc-about__divider tc-reveal\">\n\n    <p class=\"tc-about__closing tc-reveal\">At The Crazies, <span>we understand the difference</span></p>\n  </div>\n</section>\n\n<script>\n  (function () {\n    var els = document.querySelectorAll('.tc-reveal');\n    if (!('IntersectionObserver' in window)) {\n      els.forEach(function (el) { el.classList.add('tc-in-view'); });\n      return;\n    }\n    var observer = new IntersectionObserver(function (entries) {\n      entries.forEach(function (entry) {\n        if (entry.isIntersecting) {\n          entry.target.classList.add('tc-in-view');\n          observer.unobserve(entry.target);\n        }\n      });\n    }, { threshold: 0.15 });\n    els.forEach(function (el) { observer.observe(el); });\n  })();\n</script>","background_color":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}}},"order":["main","form","custom_liquid_bdcBnk"]}