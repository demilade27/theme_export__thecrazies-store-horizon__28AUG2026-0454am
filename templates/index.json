{"sections":{"custom_liquid_QADUcr":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  .tc-marquee {\n    background: #000000;\n    border-top: 2px solid #000000;\n    border-bottom: 2px solid #000000;\n    overflow: hidden;\n    padding: 12px 0;\n    white-space: nowrap;\n  }\n\n  .tc-marquee__track {\n    display: inline-flex;\n    align-items: center;\n    animation: tc-marquee-scroll 24s linear infinite;\n    will-change: transform;\n  }\n\n  .tc-marquee:hover .tc-marquee__track {\n    animation-play-state: paused;\n  }\n\n  .tc-marquee__item {\n    display: inline-flex;\n    align-items: center;\n    font-family: 'Luckiest Guy', cursive;\n    font-size: 15px;\n    color: #B50023;\n    letter-spacing: 0.5px;\n    padding: 0 20px;\n    white-space: nowrap;\n  }\n\n  .tc-marquee__star {\n    color: #F6931D;\n    font-size: 16px;\n    margin-right: 20px;\n  }\n\n  @keyframes tc-marquee-scroll {\n    from { transform: translateX(0); }\n    to   { transform: translateX(-50%); }\n  }\n\n  @media (max-width: 640px) {\n    .tc-marquee {\n      padding: 10px 0;\n    }\n    .tc-marquee__item {\n      font-size: 12px;\n      padding: 0 14px;\n    }\n    .tc-marquee__star {\n      font-size: 13px;\n      margin-right: 14px;\n    }\n    .tc-marquee__track {\n      animation-duration: 16s;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .tc-marquee__track {\n      animation: none;\n    }\n  }\n</style>\n\n\n<div class=\"tc-marquee\">\n  <div class=\"tc-marquee__track\">\n    {% assign tc_marquee_phrases = \"UNDERSTANDING THE DIFFERENCE,WORLD-WIDE SHIPPING AVAILABLE,PRE-ORDER LIVE NOW,EMBRACE YOUR INNER CHILD\" | split: \",\" %}\n    {% for i in (1..2) %}\n      {% for phrase in tc_marquee_phrases %}\n        <span class=\"tc-marquee__item\">\n          <span class=\"tc-marquee__star\">&#9733;</span>{{ phrase }}\n        </span>\n      {% endfor %}\n    {% endfor %}\n  </div>\n</div>","background_color":"","section_wi