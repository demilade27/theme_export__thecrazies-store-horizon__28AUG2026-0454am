or_palette.background }}","link_text_color":"","display_type":"text","label":"Sign up","integrated_button":false,"button_type_preset":"paragraph","padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["logo","text","text-2","email-signup"],"disabled":true,"name":"Password","settings":{"content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"center","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"center","vertical_alignment_flex_direction_column":"center","gap":12,"section_width":"page-width","background_media":"none","background_color":"","video_position":"cover","background_image_position":"cover","padding-block-start":100,"padding-block-end":100}},"custom_liquid_PTP9A9":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Luckiest+Guy&family=Architects+Daughter&display=swap\" rel=\"stylesheet\">\n\n\n<style>\n  html, body {\n    margin: 0;\n    padding: 0;\n    background: #B50023;\n  }\n\n  .tc-restock {\n    /* 8pt spacing system */\n    --tc-8: 8px;\n    --tc-16: 16px;\n    --tc-24: 24px;\n    --tc-32: 32px;\n    --tc-40: 40px;\n    --tc-48: 48px;\n    --tc-64: 64px;\n    --tc-80: 80px;\n\n    min-height: 100dvh;\n    width: 100%;\n    background: #B50023;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    box-sizing: border-box;\n    overflow-x: hidden;\n    padding:\n      max(var(--tc-40), env(safe-area-inset-top))\n      clamp(var(--tc-16), 5vw, var(--tc-32))\n      max(var(--tc-40), env(safe-area-inset-bottom));\n  }\n\n  .tc-restock *,\n  .tc-restock *::before,\n  .tc-restock *::after {\n    box-sizing: border-box;\n  }\n\n  /* ---------- Content container: capped width, centred, equal rhythm ---------- */\n  .tc-restock__container {\n    width: 100%;\n    max-width: 680px;\n    margin: 0 auto;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: clamp(var(--tc-32), 5vw, var(--tc-48));\n  }\n\n  .tc-restock__logo {\n    max-width: 220px;\n    width: clamp(140px, 40vw, 220px);\n    height: auto;\n  }\n\n  .tc-restock__heading {\n    font-family: 'Press Start 2P', cursive;\n    color: #ffffff;\n    font-size: clamp(26px, 6vw, 54px);\n    letter-spacing: 2px;\n    line-height: 1.3;\n    margin: 0;\n    text-align: center;\n  }\n\n  /* ---------- Countdown block: timer + labels kept tightly together ---------- */\n  .tc-restock__countdown-block {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: var(--tc-8);\n    width: 100%;\n  }\n\n  .tc-restock__timer {\n    display: flex;\n    align-items: baseline;\n    justify-content: center;\n    font-family: 'Luckiest Guy', cursive;\n    color: #ffffff;\n    font-size: clamp(30px, 8.5vw, 64px);\n    font-variant-numeric: tabular-nums;\n    white-space: nowrap;\n    max-width: 100%;\n  }\n\n  .tc-restock__timer-unit {\n    display: inline-block;\n    min-width: 1.1em;\n    text-align: center;\n  }\n\n  .tc-restock__colon {\n    display: inline-block;\n    font-size: 0.75em;\n    width: 0.45em;\n    opacity: 0.85;\n  }\n\n  .tc-restock__labels {\n    display: flex;\n    justify-content: center;\n    flex-wrap: wrap;\n    gap: clamp(var(--tc-8), 3vw, var(--tc-24));\n    font-family: 'Architects Daughter', cursive;\n    color: #ffffff;\n    font-size: clamp(11px, 2vw, 18px);\n    width: 100%;\n  }\n\n  .tc-restock__labels span {\n    min-width: 3.5em;\n    text-align: center;\n  }\n\n  /* ---------- Password form ---------- */\n  .tc-restock__form {\n    width: 100%;\n    max-width: 480px;\n  }\n\n  .tc-restock__field-wrap {\n    position: relative;\n    width: 100%;\n  }\n\n  .tc-restock__visually-hidden {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    margin: -1px;\n    overflow: hidden;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n    border: 0;\n  }\n\n  .tc-restock__input {\n    width: 100%;\n    min-height: 52px;\n    padding: var(--tc-16) 60px var(--tc-16) var(--tc-24);\n    border: none;\n    border-radius: 999px;\n    background: #E4E2E2;\n    color: #4a4a4a;\n    font-family: 'Architects Daughter', cursive;\n    font-size: clamp(14px, 2vw, 18px);\n    text-transform: uppercase;\n    letter-spacing: 1px;\n  }\n\n  .tc-restock__input::placeholder {\n    color: #6b6b6b;\n    text-transform: uppercase;\n  }\n\n  .tc-restock__input:focus-visible {\n    outline: 2px solid #1694CB;\n    outline-offset: 2px;\n  }\n\n  .tc-restock__submit {\n    position: absolute;\n    top: 50%;\n    right: var(--tc-8);\n    transform: translateY(-50%);\n    width: 44px;\n    height: 44px;\n    min-width: 44px;\n    min-height: 44px;\n    border-radius: 50%;\n    border: none;\n    background: #1694CB;\n    color: #ffffff;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 18px;\n    line-height: 1;\n    transition: background-color 0.2s ease;\n  }\n\n  .tc-restock__submit:hover {\n    background: #117ba8;\n  }\n\n  .tc-restock__submit:focus-visible {\n    outline: 2px solid #ffffff;\n    outline-offset: 2px;\n  }\n\n  .tc-restock__error {\n    font-family: 'Architects Daughter', cursive;\n    color: #ffe0e0;\n    font-size: 14px;\n    margin: var(--tc-8) 0 0;\n    text-align: center;\n  }\n\n  /* ---------- Footer block: flag + tagline kept tightly together ---------- */\n  .tc-restock__footer-block {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: var(--tc-16);\n  }\n\n  .tc-restock__flag {\n    max-width: 76px;\n    width: clamp(48px, 12vw, 76px);\n    height: auto;\n  }\n\n  .tc-restock__tagline {\n    font-family: 'Luckiest Guy', cursive;\n    color: #ffffff;\n    font-size: clamp(13px, 2.2vw, 20px);\n    letter-spacing: 1px;\n    margin: 0;\n    text-align: center;\n  }\n\n  /* ---------- Tablet: more air, slightly larger type, same hierarchy ---------- */\n  @media (min-width: 768px) and (max-width: 1024px) {\n    .tc-restock__container {\n      gap: clamp(var(--tc-40), 4vw, var(--tc-64));\n      max-width: 620px;\n    }\n  }\n\n  /* ---------- Desktop: intentional composition, not a stretched mobile page ---------- */\n  @media (min-width: 1024px) {\n    .tc-restock__container {\n      max-width: 680px;\n      gap: var(--tc-48);\n    }\n    .tc-restock__logo {\n      width: 200px;\n    }\n  }\n</style>\n\n{%- liquid\n  assign logo_file = files['Asset_1.PNG']\n  assign flag_file = files['LLG_NO_BACK-01-01.png']\n-%}\n\n<div class=\"tc-restock\">\n  <div class=\"tc-restock__container\">\n\n    {%- if logo_file != blank -%}\n      <img class=\"tc-restock__logo\" src=\"{{ logo_file | image_url: width: 500 }}\" alt=\"The Crazies\">\n    {%- endif -%}\n\n    <h1 class=\"tc-restock__heading\">RESTOCK</h1>\n\n    <div class=\"tc-restock__countdown-block\">\n      <div class=\"tc-restock__timer\" id=\"tcCountdownTimer\" aria-live=\"off\">\n        <span class=\"tc-restock__timer-unit\" id=\"tcDays\">--</span><span class=\"tc-restock__colon\">:</span><span class=\"tc-restock__timer-unit\" id=\"tcHours\">--</span><span class=\"tc-restock__colon\">:</span><span class=\"tc-restock__timer-unit\" id=\"tcMinutes\">--</span><span class=\"tc-restock__colon\">:</span><span class=\"tc-restock__timer-unit\" id=\"tcSeconds\">--</span>\n      </div>\n      <p class=\"tc-restock__visually-hidden\" id=\"tcCountdownSr\" aria-live=\"polite\"></p>\n\n      <div class=\"tc-restock__labels\">\n        <span>Days</span>\n        <span>Hours</span>\n        <span>Minutes</span>\n        <span>Seconds</span>\n      </div>\n    </div>\n\n    <div class=\"tc-restock__form\">\n      {% form 'storefront_password' %}\n        <div class=\"tc-restock__field-wrap\">\n          <label class=\"tc-restock__visually-hidden\" for=\"tcPasswordInput\">Store password</label>\n          <input\n            type=\"password\"\n            name=\"password\"\n            id=\"tcPasswordInput\"\n            class=\"tc-restock__input\"\n            placeholder=\"Password\"\n            required\n          >\n          <button type=\"submit\" class=\"tc-restock__submit\" aria-label=\"Enter password\">&#8594;</button>\n        </div>\n        {% if form.errors %}\n          <p class=\"tc-restock__error\" role=\"alert\">Incorrect password, try again.</p>\n        {% endif %}\n      {% endform %}\n    </div>\n\n    <div class=\"tc-restock__footer-block\">\n      {%- if flag_file != blank -%}\n        <img class=\"tc-restock__flag\" src=\"{{ flag_file | image_url: width: 200 }}\" alt=\"\">\n      {%- endif -%}\n      <p class=\"tc-restock__tagline\">UNDERSTANDING THE DIFFERENCE</p>\n    </div>\n\n  </div>\n</div>\n\n<script>\n  (function () {\n    // August 18, 2026, 7:00 PM WAT (UTC+1)\n    var targetDate = new Date('2026-08-18T19:00:00+01:00').getTime();\n\n    var daysEl = document.getElementById('tcDays');\n    var hoursEl = document.getElementById('tcHours');\n    var minutesEl = document.getElementById('tcMinutes');\n    var secondsEl = document.getElementById('tcSeconds');\n    var srEl = document.getElementById('tcCountdownSr');\n    var lastAnnouncedMinute = null;\n\n    function updateCountdown() {\n      var now = new Date().getTime();\n      var distance = targetDate - now;\n\n      if (distance <= 0) {\n        daysEl.textContent = '0';\n        hoursEl.textContent = '0';\n        minutesEl.textContent = '0';\n        secondsEl.textContent = '0';\n        srEl.textContent = 'Restock is now live.';\n        clearInterval(intervalId);\n        return;\n      }\n\n      var days = Math.floor(distance / (1000 * 60 * 60 * 24));\n      var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));\n      var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));\n      var seconds = Math.floor((distance % (1000 * 60)) / 1000);\n\n      daysEl.textContent = days;\n      hoursEl.textContent = hours;\n      minutesEl.textContent = minutes;\n      secondsEl.textContent = seconds;\n\n      if (minutes !== lastAnnouncedMinute) {\n        lastAnnouncedMinute = minutes;\n        srEl.textContent = days + ' days, ' + hours + ' hours, ' + minutes + ' minutes remaining until restock.';\n      }\n    }\n\n    updateCountdown();\n    var intervalId = setInterval(updateCountdown, 1000);\n  })();\n</script>","background_color":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}}},"order":["main","custom_liquid_PTP9A9"]}