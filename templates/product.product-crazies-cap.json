ings.color_palette.foreground }}","selected_variant_style_class":"default","custom_selected_variant_background":"{{ settings.color_palette.foreground }}","custom_selected_variant_text":"{{ settings.color_palette.background }}","custom_selected_variant_border":"{{ settings.color_palette.foreground }}","alignment":"left","padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"buy_buttons_eYQEYi":{"type":"buy-buttons","settings":{"stacking":true,"text_color":"","show_pickup_availability":false,"gift_card_form":true,"recipient_button_style":"default","recipient_button_background":"{{ settings.color_palette.background }}","recipient_button_text":"{{ settings.color_palette.foreground }}","recipient_button_border":"{{ settings.color_palette.foreground }}","selected_recipient_button_style":"default","selected_recipient_button_background":"{{ settings.color_palette.foreground }}","selected_recipient_button_text":"{{ settings.color_palette.background }}","selected_recipient_button_border":"{{ settings.color_palette.foreground }}","input_style":"default","input_background_color":"{{ settings.color_palette.background }}","input_text_color":"{{ settings.color_palette.foreground }}","input_border_color":"{{ settings.color_palette.foreground }}","border_width":1,"border_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{"quantity":{"type":"quantity","static":true,"settings":{"input_style":"default","input_background_color":"{{ settings.color_palette.background }}","input_text_color":"{{ settings.color_palette.foreground }}","input_border_color":"{{ settings.color_palette.foreground }}","border_width":1,"border_radius":0},"blocks":{}},"add-to-cart":{"type":"add-to-cart","static":true,"settings":{"style_class":"button","custom_button_background":"{{ settings.color_palette.foreground }}","custom_button_text":"{{ settings.color_palette.background }}","custom_button_border":"{{ settings.color_palette.background }}"},"blocks":{}},"accelerated-checkout":{"type":"accelerated-checkout","static":true,"settings":{},"blocks":{}}},"block_order":[]},"text_aEtTtq":{"type":"text","name":"Product description","settings":{"text":"{{ closest.product.description }}","width":"100%","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-primary--family)","font_size":"","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","text_color":"","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["group_icgrde","divider_VJhene","variant_picker_R3rGDr","buy_buttons_eYQEYi","text_aEtTtq"]}},"block_order":["disclosures"],"disabled":true,"settings":{"content_width":"content-center-aligned","desktop_media_position":"left","equal_columns":false,"limit_details_width":false,"gap":48,"enable_sticky_add_to_cart":true,"background_color":"","padding-block-start":0,"padding-block-end":0}},"custom_liquid_NH6mmV":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"\n<style>\n  .tc-pdp {\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 48px 24px 64px;\n    display: grid;\n    grid-template-columns: 1.1fr 1fr;\n    gap: 56px;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  \/* ---------- Gallery ---------- *\/\n  .tc-pdp__gallery {\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n  }\n\n  .tc-pdp__main-image {\n    position: relative;\n    width: 100%;\n    aspect-ratio: 1 \/ 1;\n    border-radius: 20px;\n    overflow: hidden;\n    background: #FAF8F5;\n  }\n\n  .tc-pdp__main-image img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    opacity: 1;\n    transition: opacity 0.3s ease;\n  }\n\n  .tc-pdp__badge {\n    position: absolute;\n    top: 16px;\n    left: 16px;\n    background: #B50023;\n    color: #fff;\n    font-family: 'Luckiest Guy', cursive;\n    font-size: 13px;\n    letter-spacing: 0.5px;\n    padding: 7px 16px;\n    border-radius: 999px;\n    box-shadow: 0 4px 10px rgba(181, 0, 35, 0.3);\n    z-index: 2;\n  }\n\n  .tc-pdp__thumbs {\n    display: flex;\n    gap: 10px;\n    flex-wrap: wrap;\n  }\n\n  .tc-pdp__thumb {\n    width: 76px;\n    height: 76px;\n    border-radius: 12px;\n    overflow: hidden;\n    background: #FAF8F5;\n    border: 2px solid transparent;\n    cursor: pointer;\n    padding: 0;\n    transition: border-color 0.25s ease;\n  }\n\n  .tc-pdp__thumb.is-active {\n    border-color: #B50023;\n  }\n\n  .tc-pdp__thumb img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n  }\n\n  \/* ---------- Info column ---------- *\/\n  .tc-pdp__info {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .tc-pdp__collection-tag {\n    font-family: 'Architects Daughter', cursive;\n    font-size: 14px;\n    color: #1694CB;\n    margin: 0 0 8px;\n    text-decoration: none;\n    display: inline-block;\n  }\n\n  .tc-pdp__title {\n    font-family: 'Luckiest Guy', cursive;\n    font-size: 34px;\n    color: #B50023;\n    letter-spacing: 0.5px;\n    margin: 0 0 10px;\n  }\n\n  .tc-pdp__price {\n    font-family: 'Architects Daughter', cursive;\n    font-size: 22px;\n    color: #1a1a1a;\n    margin: 0 0 24px;\n  }\n\n  .tc-pdp__tagline {\n    font-family: 'Architects Daughter', cursive;\n    font-size: 18px;\n    color: #1a1a1a;\n    margin: 0 0 24px;\n    padding-left: 14px;\n    border-left: 3px solid #B50023;\n  }\n\n  \/* Quantity + CTA *\/\n  .tc-pdp__form {\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n    margin-bottom: 32px;\n  }\n\n  .tc-pdp__qty-row {\n    display: flex;\n    align-items: center;\n    gap: 16px;\n  }\n\n  .tc-pdp__qty-label {\n    font-family: 'Architects Daughter', cursive;\n    font-size: 15px;\n    color: #666;\n  }\n\n  .tc-pdp__qty-stepper {\n    display: inline-flex;\n    align-items: center;\n    border: 2px solid #eee;\n    border-radius: 999px;\n    overflow: hidden;\n  }\n\n  .tc-pdp__qty-btn {\n    width: 38px;\n    height: 38px;\n    background: none;\n    border: none;\n    font-size: 18px;\n    color: #B50023;\n    cursor: pointer;\n    font-family: 'Luckiest Guy', cursive;\n  }\n\n  .tc-pdp__qty-input {\n    width: 42px;\n    text-align: center;\n    border: none;\n    font-family: 'Architects Daughter', cursive;\n    font-size: 16px;\n    -moz-appearance: textfield;\n  }\n\n  .tc-pdp__qty-input::-webkit-outer-spin-button,\n  .tc-pdp__qty-input::-webkit-inner-spin-button {\n    -webkit-appearance: none;\n    margin: 0;\n  }\n\n  .tc-pdp__cta {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 100%;\n    padding: 18px 24px;\n    background: #B50023;\n    color: #fff;\n    border: none;\n    border-radius: 999px;\n    font-family: 'Luckiest Guy', cursive;\n    font-size: 17px;\n    letter-spacing: 0.5px;\n    cursor: pointer;\n    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), background 0.25s ease;\n  }\n\n  .tc-pdp__cta:hover {\n    transform: translateY(-3px);\n    background: #8f001c;\n  }\n\n  .tc-pdp__stock {\n    font-family: 'Architects Daughter', cursive;\n    font-size: 14px;\n    color: #2a9d5c;\n    margin: 0;\n  }\n\n  \/* Description from product.description *\/\n  .tc-pdp__description {\n    font-family: 'Architects Daughter', cursive;\n    font-size: 16px;\n    line-height: 1.75;\n    color: #1a1a1a;\n    margin-bottom: 8px;\n  }\n\n  .tc-pdp__description p {\n    margin: 0 0 16px;\n  }\n\n  .tc-pdp__description ul {\n    margin: 0 0 16px;\n    padding-left: 20px;\n  }\n\n  .tc-pdp__description li {\n    margin-bottom: 6px;\n  }\n\n  \/* Accordions *\/\n  .tc-pdp__accordion {\n    border-top: 1px solid #eee;\n  }\n\n  .tc-pdp__accordion:last-child {\n    border-bottom: 1px solid #eee;\n  }\n\n  .tc-pdp__accordion summary {\n    list-style: none;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 16px 0;\n    cursor: pointer;\n    font-family: 'Luckiest Guy', cursive;\n    font-size: 15px;\n    color: #B50023;\n    letter-spacing: 0.3px;\n  }\n\n  .tc-pdp__accordion summary::-webkit-details-marker {\n    display: none;\n  }\n\n  .tc-pdp__accordion summary::after {\n    content: '+';\n    font-size: 20px;\n    color: #1694CB;\n    transition: transform 0.3s ease;\n  }\n\n  .tc-pdp__accordion[open] summary::after {\n    transform: rotate(45deg);\n  }\n\n  .tc-pdp__accordion-body {\n    font-family: 'Architects Daughter', cursive;\n    font-size: 15px;\n    line-height: 1.7;\n    color: #333;\n    padding-bottom: 18px;\n  }\n\n  .tc-pdp__accordion-body ul {\n    margin: 0;\n    padding-left: 18px;\n  }\n\n  .tc-pdp__accordion-body li {\n    margin-bottom: 4px;\n  }\n\n  \/* ---------- Sticky bottom bar ---------- *\/\n  .tc-pdp__sticky {\n    position: fixed;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    z-index: 50;\n    background: #ffffff;\n    border-top: 1px solid #eee;\n    box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.08);\n    padding: 12px 20px;\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    transform: translateY(100%);\n    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);\n  }\n\n  .tc-pdp__sticky.is-visible {\n    transform: translateY(0);\n  }\n\n  .tc-pdp__sticky-img {\n    width: 48px;\n    height: 48px;\n    border-radius: 10px;\n    overflow: hidden;\n    background: #FAF8F5;\n    flex-shrink: 0;\n  }\n\n  .tc-pdp__sticky-img img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n  }\n\n  .tc-pdp__sticky-info {\n    flex: 1;\n    min-width: 0;\n  }\n\n  .tc-pdp__sticky-title {\n    font-family: 'Luckiest Guy', cursive;\n    font-size: 14px;\n    color: #B50023;\n    margin: 0;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n\n  .tc-pdp__sticky-price {\n    font-family: 'Architects Daughter', cursive;\n    font-size: 13px;\n    color: #666;\n    margin: 0;\n  }\n\n  .tc-pdp__sticky-cta {\n    background: #B50023;\n    color: #fff;\n    border: none;\n    border-radius: 999px;\n    padding: 12px 24px;\n    font-family: 'Luckiest Guy', cursive;\n    font-size: 13px;\n    letter-spacing: 0.3px;\n    cursor: pointer;\n    flex-shrink: 0;\n    white-space: nowrap;\n  }\n\n  \/* ---------- Mobile ---------- *\/\n  @media (max-width: 900px) {\n    .tc-pdp {\n      grid-template-columns: 1fr;\n      gap: 32px;\n      padding: 32px 16px 48px;\n    }\n    .tc-pdp__title {\n      font-size: 26px;\n    }\n    .tc-pdp__price {\n      font-size: 19px;\n    }\n  }\n\n  @media (max-width: 480px) {\n    .tc-pdp__sticky-title {\n      max-width: 120px;\n    }\n  }\n<\/style>\n\n<section class=\"tc-pdp\">\n\n  <div class=\"tc-pdp__gallery\">\n    <div class=\"tc-pdp__main-image\" id=\"tc-pdp-main\">\n      {% if product.tags contains 'pre-order' %}\n        <span class=\"tc-pdp__badge\">PRE-ORDER<\/span>\n      {% endif %}\n      {% for image in product.images %}\n        <img\n          src=\"{{ image | image_url: width: 900 }}\"\n          alt=\"{{ product.title | escape }}\"\n          class=\"tc-pdp__main-img-el\"\n          style=\"{% unless forloop.first %}display:none;{% endunless %}\"\n          data-index=\"{{ forloop.index0 }}\"\n        >\n      {% endfor %}\n    <\/div>\n\n    {% if product.images.size > 1 %}\n      <div class=\"tc-pdp__thumbs\">\n        {% for image in product.images %}\n          <button type=\"button\" class=\"tc-pdp__thumb{% if forloop.first %} is-active{% endif %}\" data-index=\"{{ forloop.index0 }}\" aria-label=\"View image {{ forloop.index }}\">\n            <img src=\"{{ image | image_url: width: 150 }}\" alt=\"{{ product.title | escape }} thumbnail {{ forloop.index }}\">\n          <\/button>\n        {% endfor %}\n      <\/div>\n    {% endif %}\n  <\/div>\n\n  <div class=\"tc-pdp__info\">\n    {% if product.collections.first %}\n      <a href=\"{{ product.collections.first.url }}\" class=\"tc-pdp__collection-tag\">{{ product.collections.first.title }}<\/a>\n    {% endif %}\n\n    <h1 class=\"tc-pdp__title\">{{ product.title | upcase }}<\/h1>\n    <p class=\"tc-pdp__price\">{{ product.price | money }}<\/p>\n\n    {% if product.metafields.custom.tagline != blank %}\n      <p class=\"tc-pdp__tagline\">{{ product.metafields.custom.tagline }}<\/p>\n    {% endif %}\n\n    {% form 'product', product, id: 'tc-pdp-form' %}\n      <div class=\"tc-pdp__form\">\n        <div class=\"tc-pdp__qty-row\">\n          <span class=\"tc-pdp__qty-label\">Quantity<\/span>\n          <div class=\"tc-pdp__qty-stepper\">\n            <button type=\"button\" class=\"tc-pdp__qty-btn\" id=\"tc-qty-minus\">−<\/button>\n            <input type=\"number\" name=\"quantity\" id=\"tc-qty-input\" class=\"tc-pdp__qty-input\" value=\"1\" min=\"1\">\n            <button type=\"button\" class=\"tc-pdp__qty-btn\" id=\"tc-qty-plus\">+<\/button>\n          <\/div>\n        <\/div>\n\n        <input type=\"hidden\" name=\"id\" value=\"{{ product.selected_or_first_available_variant.id }}\">\n\n        <button type=\"submit\" class=\"tc-pdp__cta\" id=\"tc-pdp-cta\">\n          {% if product.tags contains 'pre-order' %}Pre-order Now{% else %}Add to Cart{% endif %}\n        <\/button>\n\n        {% if product.available %}\n          <p class=\"tc-pdp__stock\">In stock<\/p>\n        {% endif %}\n      <\/div>\n    {% endform %}\n\n    {% if product.description != blank %}\n      <div class=\"tc-pdp__description\">{{ product.description }}<\/div>\n    {% endif %}\n\n    <details class=\"tc-pdp__accordion\">\n      <summary>Size Guide<\/summary>\n      <div class=\"tc-pdp__accordion-body\">\n        <p><strong>Snapback Cap<\/strong><br>One size fits most (54–60 cm)<\/p>\n      <\/div>\n    <\/details>\n\n    <details class=\"tc-pdp__accordion\">\n      <summary>Care Instructions<\/summary>\n      <div class=\"tc-pdp__accordion-body\">\n        <ul>\n          <li>Do not machine wash<\/li>\n          <li>Do not tumble dry<\/li>\n          <li>Air dry only<\/li>\n          <li>Avoid contact with chemicals<\/li>\n          <li>Do not iron<\/li>\n        <\/ul>\n      <\/div>\n    <\/details>\n\n    <details class=\"tc-pdp__accordion\">\n      <summary>Shipping Information<\/summary>\n      <div class=\"tc-pdp__accordion-body\">\n        <p><strong>Local (Nigeria)<\/strong><br>Orders are processed and shipped from our Lagos base.<\/p>\n        <p><strong>International<\/strong><br>We ship worldwide. Delivery times and costs vary by location and are calculated at checkout.<\/p>\n      <\/div>\n    <\/details>\n\n    <details class=\"tc-pdp__accordion\">\n      <summary>Returns &amp; Exchanges<\/summary>\n      <div class=\"tc-pdp__accordion-body\">\n        <p>Contact us within 14 days of receiving your order if there's an issue. Items must be unused and in original packaging.<\/p>\n      <\/div>\n    <\/details>\n  <\/div>\n\n<\/section>\n\n<!-- Sticky bottom bar -->\n<div class=\"tc-pdp__sticky\" id=\"tc-pdp-sticky\">\n  <div class=\"tc-pdp__sticky-img\">\n    {% if product.featured_image %}\n      <img src=\"{{ product.featured_image | image_url: width: 150 }}\" alt=\"{{ product.title | escape }}\">\n    {% endif %}\n  <\/div>\n  <div class=\"tc-pdp__sticky-info\">\n    <p class=\"tc-pdp__sticky-title\">{{ product.title }}<\/p>\n    <p class=\"tc-pdp__sticky-price\">{{ product.price | money }}<\/p>\n  <\/div>\n  <button type=\"button\" class=\"tc-pdp__sticky-cta\" id=\"tc-pdp-sticky-cta\">\n    {% if product.tags contains 'pre-order' %}Pre-order{% else %}Add to Cart{% endif %}\n  <\/button>\n<\/div>\n\n<script>\n  (function () {\n    \/\/ Gallery thumbnail switching\n    var mainImages = document.querySelectorAll('.tc-pdp__main-img-el');\n    var thumbs = document.querySelectorAll('.tc-pdp__thumb');\n    thumbs.forEach(function (thumb) {\n      thumb.addEventListener('click', function () {\n        var index = thumb.getAttribute('data-index');\n        mainImages.forEach(function (img) {\n          img.style.display = img.getAttribute('data-index') === index ? '' : 'none';\n        });\n        thumbs.forEach(function (t) { t.classList.remove('is-active'); });\n        thumb.classList.add('is-active');\n      });\n    });\n\n    \/\/ Quantity stepper\n    var qtyInput = document.getElementById('tc-qty-input');\n    var minusBtn = document.getElementById('tc-qty-minus');\n    var plusBtn = document.getElementById('tc-qty-plus');\n    if (minusBtn && plusBtn && qtyInput) {\n      minusBtn.addEventListener('click', function () {\n        var val = parseInt(qtyInput.value, 10) || 1;\n        qtyInput.value = Math.max(1, val - 1);\n      });\n      plusBtn.addEventListener('click', function () {\n        var val = parseInt(qtyInput.value, 10) || 1;\n        qtyInput.value = val + 1;\n      });\n    }\n\n    \/\/ Sticky bar: show once main CTA scrolls out of view\n    var mainCta = document.getElementById('tc-pdp-cta');\n    var sticky = document.getElementById('tc-pdp-sticky');\n    var stickyCta = document.getElementById('tc-pdp-sticky-cta');\n    var mainForm = document.getElementById('tc-pdp-form');\n\n    if (mainCta && sticky && 'IntersectionObserver' in window) {\n      var observer = new IntersectionObserver(function (entries) {\n        entries.forEach(function (entry) {\n          if (entry.isIntersecting) {\n            sticky.classList.remove('is-visible');\n          } else {\n            sticky.classList.add('is-visible');\n          }\n        });\n      }, { threshold: 0 });\n      observer.observe(mainCta);\n    }\n\n    \/\/ Sticky CTA triggers the real form submit\n    if (stickyCta && mainForm) {\n      stickyCta.addEventListener('click', function () {\n        if (mainForm.requestSubmit) {\n          mainForm.requestSubmit();\n        } else {\n          mainForm.submit();\n        }\n      });\n    }\n  })();\n<\/script>","background_color":"","section_width":"page-widt