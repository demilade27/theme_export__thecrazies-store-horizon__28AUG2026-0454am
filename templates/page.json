{"sections":{"main":{"type":"main-page","blocks":{"text_XCBwwq":{"type":"text","name":"t:names.heading","settings":{"text":"<h2>CHARACTERS</h2>","width":"100%","max_width":"normal","alignment":"center","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","text_color":"#b50023","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_XCBwwq"],"settings":{"content_direction":"column","gap":32,"background_color":"","padding-block-start":40,"padding-block-end":80}},"custom_liquid_QDqigq":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  .tc-char3-hero {\n    width: 100%;\n    height: 220px;\n    overflow: hidden;\n  }\n\n  .tc-char3-hero video {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n\n  @media (max-width: 640px) {\n    .tc-char3-hero {\n      height: 160px;\n    }\n  }\n</style>\n\n<div class=\"tc-char3-hero\">\n  <video autoplay muted loop playsinline preload=\"metadata\">\n    <source src=\"{{ 'Untitled design (1).mp4' | file_url }}\" type=\"video/mp4\">\n  </video>\n</div>","background_color":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"custom_liquid_LL9R68":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Luckiest+Guy&family=Architects+Daughter&display=swap\" rel=\"stylesheet\">\n\n\n<style>\n  .tc-char3-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    width: 100%;\n    height: 88vh;\n    min-height: 560px;\n  }\n\n  .tc-char3 {\n    position: relative;\n    overflow: hidden;\n    background: #1a1a1a;\n    display: block;\n    text-decoration: none;\n  }\n\n  .tc-char3__img {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: top center;\n    transition: opacity 0.8s ease, transform 1.1s cubic-bezier(0.19, 1, 0.22, 1);\n  }\n\n  .tc-char3__img--default {\n    opacity: 1;\n    transform: scale(1);\n  }\n\n  .tc-char3__img--hover {\n    opacity: 0;\n    transform: scale(1.08);\n  }\n\n  .tc-char3:hover .tc-char3__img--default {\n    opacity: 0;\n  }\n\n  .tc-char3:hover .tc-char3__img--hover {\n    opacity: 1;\n    transform: scale(1);\n  }\n\n  .tc-char3::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background:\n      linear-gradient(180deg,\n        rgba(0,0,0,0) 30%,\n        rgba(var(--tc-accent-rgb), 0.28) 62%,\n        rgba(var(--tc-accent-rgb), 0.5) 82%,\n        rgba(20,16,18,0.88) 100%\n      );\n    transition: background 0.6s ease;\n    z-index: 1;\n  }\n\n  .tc-char3:hover::before {\n    background:\n      linear-gradient(180deg,\n        rgba(var(--tc-accent-rgb), 0.12) 0%,\n        rgba(var(--tc-accent-rgb), 0.18) 40%,\n        rgba(var(--tc-accent-rgb), 0.62) 78%,\n        rgba(20,16,18,0.92) 100%\n      );\n  }\n\n  .tc-char3::after {\n    content: '';\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 6px;\n    height: 100%;\n    background: var(--tc-accent);\n    z-index: 2;\n  }\n\n  .tc-char3__content {\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    z-index: 3;\n    padding: 28px 24px 32px;\n    color: #ffffff;\n    text-align: left;\n  }\n\n  .tc-char3__name {\n    font-family: 'Press Start 2P', cursive;\n    font-size: 15px;\n    letter-spacing: 1px;\n    margin: 0 0 10px;\n    text-shadow: 0 2px 10px rgba(0,0,0,0.35);\n    transition: transform 0.5s cubic-bezier(0.19, 1, 0.22, 1);\n  }\n\n  .tc-char3:hover .tc-char3__name {\n    transform: translateY(-4px);\n  }\n\n  .tc-char3__trait {\n    display: inline-block;\n    font-family: 'Luckiest Guy', cursive;\n    font-size: 15px;\n    letter-spacing: 0.5px;\n    background: var(--tc-accent);\n    color: #ffffff;\n    padding: 7px 16px;\n    border-radius: 999px;\n    box-shadow: 0 6px 16px rgba(0,0,0,0.25);\n    opacity: 0;\n    transform: translateY(10px);\n    transition: opacity 0.5s cubic-bezier(0.19, 1, 0.22, 1) 0.05s,\n                transform 0.5s cubic-bezier(0.19, 1, 0.22, 1) 0.05s;\n  }\n\n  .tc-char3:hover .tc-char3__trait {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  .tc-char3--sounds  { --tc-accent: #B50023; --tc-accent-rgb: 181, 0, 35; }\n  .tc-char3--retro   { --tc-accent: #74432B; --tc-accent-rgb: 116, 67, 43; }\n  .tc-char3--skipper { --tc-accent: #1694CB; --tc-accent-rgb: 22, 148, 203; }\n  .tc-char3--jeff    { --tc-accent: #6ABD51; --tc-accent-rgb: 106, 189, 81; }\n\n  .tc-char3-footer-banner {\n    max-width: 1200px;\n    margin: 40px auto;\n    border: 3px solid #B50023;\n    border-radius: 16px;\n    overflow: hidden;\n    line-height: 0;\n  }\n\n  .tc-char3-footer-banner img {\n    width: 100%;\n    height: auto;\n    display: block;\n  }\n\n  @media (max-width: 900px) {\n    .tc-char3-grid {\n      grid-template-columns: repeat(2, 1fr);\n      height: auto;\n      min-height: 0;\n    }\n    .tc-char3 {\n      height: 50vh;\n      min-height: 380px;\n    }\n    .tc-char3__content {\n      padding: 20px 18px 24px;\n    }\n    .tc-char3__name {\n      font-size: 12px;\n      line-height: 1.4;\n      word-break: break-word;\n    }\n    .tc-char3__trait {\n      font-size: 13px;\n      padding: 6px 13px;\n    }\n  }\n\n  @media (max-width: 640px) {\n    .tc-char3-grid {\n      grid-template-columns: 1fr;\n    }\n    .tc-char3 {\n      height: 55vh;\n      min-height: 400px;\n    }\n    .tc-char3::before {\n      background:\n        linear-gradient(180deg,\n          rgba(0,0,0,0) 25%,\n          rgba(var(--tc-accent-rgb), 0.35) 65%,\n          rgba(20,16,18,0.9) 100%\n        );\n    }\n    .tc-char3__content {\n      padding: 18px 16px 22px;\n    }\n    .tc-char3__name {\n      font-size: 11px;\n    }\n    .tc-char3__trait {\n      font-size: 12px;\n      padding: 6px 12px;\n    }\n    .tc-char3__img--hover {\n      display: none;\n    }\n    .tc-char3:hover .tc-char3__img--default {\n      opacity: 1;\n    }\n    .tc-char3__trait {\n      opacity: 1;\n      transform: translateY(0);\n    }\n    .tc-char3-footer-banner {\n      margin: 28px 16px;\n      border-radius: 12px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .tc-char3__img,\n    .tc-char3::before,\n    .tc-char3__name,\n    .tc-char3__trait {\n      transition: none;\n    }\n  }\n</style>\n\n<div class=\"tc-char3-grid\">\n\n  <div class=\"tc-char3 tc-char3--sounds\">\n    <img class=\"tc-char3__img tc-char3__img--default\" src=\"{{ 'SOUNDS.png' | file_url }}\" alt=\"Sounds character\">\n    <img class=\"tc-char3__img tc-char3__img--hover\" src=\"{{ 'SOUNDS_HOVER.png' | file_url }}\" alt=\"Sounds character, full pose\">\n    <div class=\"tc-char3__content\">\n      <h3 class=\"tc-char3__name\">SOUNDS</h3>\n      <span class=\"tc-char3__trait\">Noise Maker</span>\n    </div>\n  </div>\n\n  <div class=\"tc-char3 tc-char3--retro\">\n    <img class=\"tc-char3__img tc-char3__img--default\" src=\"{{ 'RETRO.png' | file_url }}\" alt=\"Retro character\">\n    <img class=\"tc-char3__img tc-char3__img--hover\" src=\"{{ 'RETRO_HOVER.png' | file_url }}\" alt=\"Retro character, full pose\">\n    <div class=\"tc-char3__content\">\n      <h3 class=\"tc-char3__name\">RETRO</h3>\n      <span class=\"tc-char3__trait\">The Old Soul</span>\n    </div>\n  </div>\n\n  <div class=\"tc-char3 tc-char3--skipper\">\n    <img class=\"tc-char3__img tc-char3__img--default\" src=\"{{ 'SKIPPER.png' | file_url }}\" alt=\"Skipper character\">\n    <img class=\"tc-char3__img tc-char3__img--hover\" src=\"{{ 'SKIPPER_HOVER.png' | file_url }}\" alt=\"Skipper character, full pose\">\n    <div class=\"tc-char3__content\">\n      <h3 class=\"tc-char3__name\">SKIPPER</h3>\n      <span class=\"tc-char3__trait\">Wild Card</span>\n    </div>\n  </div>\n\n  <div class=\"tc-char3 tc-char3--jeff\">\n    <img class=\"tc-char3__img tc-char3__img--default\" src=\"{{ 'JEFF.png' | file_url }}\" alt=\"Jeff character\">\n    <img class=\"tc-char3__img tc-char3__img--hover\" src=\"{{ 'JEFF_HOVER.png' | file_url }}\" alt=\"Jeff character, full pose\">\n    <div class=\"tc-char3__content\">\n      <h3 class=\"tc-char3__name\">JEFF</h3>\n      <span class=\"tc-char3__trait\">Calm Storm</span>\n    </div>\n  </div>\n\n</div>\n\n<div class=\"tc-char3-footer-banner\">\n  <img\n    src=\"{{ 'pako_coming_soon.png' | file_url }}\"\n    alt=\"The Estate Stories - coming soon\"\n    loading=\"lazy\"\n  >\n</div>","background_color":"","section_width":"full-width","padding-block-start":0,"padding-block-end":0}}},"order":["main","custom_liquid_QDqigq","custom_liquid_LL9R68"]}