{% doc %}
  Lightweight fade/slide-up reveal for any element marked with the
  `crazies-reveal` class. Respects prefers-reduced-motion.
{% enddoc %}

{% style %}
  .crazies-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .crazies-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .crazies-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
{% endstyle %}

<script>
  (function () {
    if (!('IntersectionObserver' in window)) {
      document.querySelectorAll('.crazies-reveal').forEach(function (el) {
        el.classList.add('is-visible');
      });
      return;
    }

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
    );

    function observeAll() {
      document.querySelectorAll('.crazies-reveal:not(.is-visible)').forEach(function (el) {
        observer.observe(el);
      });
    }

    document.addEventListener('DOMContentLoaded', observeAll);
    document.addEventListener('shopify:section:load', observeAll);
  })();
</script>
