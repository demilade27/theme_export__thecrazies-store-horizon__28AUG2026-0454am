{% doc %}
  Renders all global scripts, module preloads, and importmaps for the theme.

  @param {object} [product] - The product object, available on product pages.
{% enddoc %}

<script type="importmap">
  {
    "imports": {
      "@theme/overflow-list": "{{ 'overflow-list.js' | asset_url }}",
      "@theme/component": "{{ 'component.js' | asset_url }}",
      "@theme/dialog": "{{ 'dialog.js' | asset_url }}",
      "@theme/events": "{{ 'events.js' | asset_url }}",
      "@shopify/events": "https://cdn.shopify.com/storefront/standard-events.js",
      "@theme/view-event-elements": "{{ 'view-event-elements.js' | asset_url }}",
      "@theme/focus": "{{ 'focus.js' | asset_url }}",
      "@theme/morph": "{{ 'morph.js' | asset_url }}",
      "@theme/paginated-list": "{{ 'paginated-list.js' | asset_url }}",
      "@theme/performance": "{{ 'performance.js' | asset_url }}",
      "@theme/product-form": "{{ 'product-form.js' | asset_url }}",
      "@theme/recently-viewed-products": "{{ 'recently-viewed-products.js' | asset_url }}",
      "@theme/scrolling": "{{ 'scrolling.js' | asset_url }}",
      "@theme/section-renderer": "{{ 'section-renderer.js' | asset_url }}",
      "@theme/section-hydration": "{{ 'section-hydration.js' | asset_url }}",
      "@theme/money-formatting": "{{ 'money-formatting.js' | asset_url }}",
      "@theme/utilities": "{{ 'utilities.js' | asset_url }}",
      "@theme/variant-picker": "{{ 'variant-picker.js' | asset_url }}",
      "@theme/media-gallery": "{{ 'media-gallery.js' | asset_url }}",
      "@theme/quick-add": "{{ 'quick-add.js' | asset_url }}",
      "@theme/paginated-list-aspect-ratio": "{{ 'paginated-list-aspect-ratio.js' | asset_url }}",
      "@theme/popover-polyfill": "{{ 'popover-polyfill.js' | asset_url }}",
      "@theme/component-quantity-selector": "{{ 'component-quantity-selector.js' | asset_url }}",
      "@theme/comparison-slider": "{{ 'comparison-slider.js' | asset_url }}",
      "@theme/sticky-add-to-cart": "{{ 'sticky-add-to-cart.js' | asset_url }}",
      "@theme/fly-to-cart": "{{ 'fly-to-cart.js' | asset_url }}",
      "@theme/scroll-container": "{{ 'scroll-container.js' | asset_url }}",
      "@theme/theme-drawer": "{{ 'theme-drawer.js' | asset_url }}"
    }
  }
</script>

{%- comment -%}
  Registers Horizon's cart-drawer behaviour against the standard-actions
  bundle (loaded separately into <head>). Module scripts execute in
  document order, so this runs after the bundle regardless of where it
  lands in <head>.
{%- endcomment -%}
<script
  src="{{ 'standard-actions-override.js' | asset_url }}"
  type="module"
></script>

<script
  src="{{ 'page-view-event.js' | asset_url }}"
  type="module"
  defer
></script>

{% if settings.page_transition_enabled or settings.transition_to_main_product %}
  <script
    src="{{ 'view-transitions.js' | asset_url }}"
    async
    blocking="render"
  ></script>
{% else %}
  {%- comment -%}
    base.css opts browsers into cross-document transitions. When both related
    settings are off, disable that browser work as well as the JS controller.
  {%- endcomment -%}
  <style>@view-transition { navigation: none; }</style>
{% endif %}

<link
  rel="modulepreload"
  href="{{ 'utilities.js' | asset_url }}"
  fetchpriority="low"
>
<link
  rel="modulepreload"
  href="{{ 'component.js' | asset_url }}"
  fetchpriority="low"
>

{% if template.name == 'collection' or template.name == 'search' %}
  <link
    rel="modulepreload"
    href="{{ 'paginated-list-aspect-ratio.js' | asset_url }}"
    fetchpriority="low"
  >
  <link
    rel="modulepreload"
    href="{{ 'paginated-list.js' | asset_url }}"
    fetchpriority="low"
  >
{% endif %}

<link
  rel="modulepreload"
  href="{{ 'focus.js' | asset_url }}"
  fetchpriority="low"
>
<link
  rel="modulepreload"
  href="{{ 'recently-viewed-products.js' | asset_url }}"
  fetchpriority="low"
>
<link
  rel="modulepreload"
  href="{{ 'scrolling.js' | asset_url }}"
  fetchpriority="low"
>
<link
  rel="modulepreload"
  href="{{ 'events.js' | asset_url }}"
  fetchpriority="low"
>
{%- comment -%}
  Feature modules used to be evaluated on every page. Import each one only when
  its custom element is present; the observer also covers HTML added later by
  Shopify's Section Rendering API.
{%- endcomment -%}
<script type="module">
  const themeFeatureModules = [
    ['overflow-list', '{{ 'overflow-list.js' | asset_url }}'],
    ['quick-add-component, quick-add-dialog', '{{ 'quick-add.js' | asset_url }}'],
    ['dialog-component', '{{ 'dialog.js' | asset_url }}'],
    ['variant-picker', '{{ 'variant-picker.js' | asset_url }}'],
    ['product-card-link, product-card, swatches-variant-picker-component', '{{ 'product-card.js' | asset_url }}'],
    ['add-to-cart-component, product-form-component', '{{ 'product-form.js' | asset_url }}'],
    ['fly-to-cart', '{{ 'fly-to-cart.js' | asset_url }}'],
    ['accordion-custom', '{{ 'accordion-custom.js' | asset_url }}'],
    ['deferred-media, product-model', '{{ 'media.js' | asset_url }}'],
    ['product-price', '{{ 'product-price.js' | asset_url }}'],
    ['product-sku-component', '{{ 'product-sku.js' | asset_url }}'],
    ['product-inventory', '{{ 'product-inventory.js' | asset_url }}'],
    ['show-more-component', '{{ 'show-more.js' | asset_url }}'],
    ['slideshow-component', '{{ 'slideshow.js' | asset_url }}'],
    ['layered-slideshow-component', '{{ 'layered-slideshow.js' | asset_url }}'],
    ['anchored-popover-component', '{{ 'anchored-popover.js' | asset_url }}'],
    ['floating-panel-component', '{{ 'floating-panel.js' | asset_url }}'],
    ['video-background-component', '{{ 'video-background.js' | asset_url }}'],
    ['quantity-selector-component', '{{ 'component-quantity-selector.js' | asset_url }}'],
    ['media-gallery', '{{ 'media-gallery.js' | asset_url }}'],
    ['rte-formatter', '{{ 'rte-formatter.js' | asset_url }}'],
    ['volume-pricing', '{{ 'volume-pricing.js' | asset_url }}'],
    ['price-per-item', '{{ 'price-per-item.js' | asset_url }}'],
    ['volume-pricing-info', '{{ 'volume-pricing-info.js' | asset_url }}'],
  ];

  const loadedModules = new Set();
  const loadMatchingModules = (root = document) => {
    for (const [selector, url] of themeFeatureModules) {
      if (!loadedModules.has(url) && root.querySelector(selector)) {
        loadedModules.add(url);
        import(url);
      }
    }

    // Modern browsers natively support popovers, so avoid evaluating the
    // 26 KB compatibility bundle for them.
    if (
      !loadedModules.has('popover-polyfill') &&
      !('showPopover' in HTMLElement.prototype) &&
      root.querySelector('[popover], [popovertarget]')
    ) {
      loadedModules.add('popover-polyfill');
      import('{{ 'popover-polyfill.js' | asset_url }}');
    }
  };

  loadMatchingModules();
  let moduleScanQueued = false;
  new MutationObserver((mutations) => {
    if (moduleScanQueued || !mutations.some((mutation) => mutation.addedNodes.length > 0)) return;

    // Third-party apps and section updates often add many nodes in one turn.
    // Scan once per frame instead of running every selector for every node.
    moduleScanQueued = true;
    requestAnimationFrame(() => {
      moduleScanQueued = false;
      loadMatchingModules();
    });
  }).observe(document.body, { childList: true, subtree: true });
</script>
{% if settings.show_add_discount_code %}
  <script
    src="{{ 'cart-discount.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}


{% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}
  <script
    src="{{ 'localization.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% if template == 'product' or template.name == 'product' or request.page_type == 'product' %}
  <script
    src="{{ 'sticky-add-to-cart.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
  <script type="module">
    import { RecentlyViewed } from '@theme/recently-viewed-products';
    RecentlyViewed.addProduct('{{ product.id }}');
  </script>
{% endif %}

<script
  src="{{ 'auto-close-details.js' | asset_url }}"
  defer="defer"
></script>

<script>
  const Theme = {
    translations: {
      placeholder_image: `{{ 'content.placeholder_image' | t }}`,
      added: `{{ 'actions.added' | t }}`,
      recipient_form_fields_visible: `{{ 'content.recipient_form_fields_visible' | t }}`,
      recipient_form_fields_hidden: `{{ 'content.recipient_form_fields_hidden' | t }}`,
      recipient_form_error: `{{ 'content.recipient_form_error' | t }}`,
      items_added_to_cart_one: `{{ 'content.items_added_to_cart.one' | t }}`,
      items_added_to_cart_other: `{{ 'content.items_added_to_cart.other' | t }}`,
      cart_count: `{{ 'accessibility.cart_count' | t }}`,
    },
    routes: {
      cart_add_url: '{{ routes.cart_add_url | append: '.js' }}',
      cart_change_url: '{{ routes.cart_change_url }}',
      cart_update_url: '{{ routes.cart_update_url }}',
      cart_url: '{{ routes.cart_url }}',
      predictive_search_url: '{{ routes.predictive_search_url }}',
      search_url: '{{ routes.search_url }}',
    },
    template: {
      name: '{{ template }}',
    },
  };
</script>
